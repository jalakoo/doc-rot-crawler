# =============================================================================
#  docrot - environment
#  Copy to .env and fill in.  Everything except the graph store is optional;
#  the pipeline degrades rather than failing when a key is absent.
# =============================================================================

# -----------------------------------------------------------------------------
# Sandbox execution (Daytona) - REQUIRED for the `execute` and `structural`
# tiers. Without it, the runner is skipped and pages are reported as
# `unverified` rather than pass/fail.
# -----------------------------------------------------------------------------
DAYTONA_API_KEY=
# Optional. Only set if you are on a self-hosted or non-default Daytona region.
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# -----------------------------------------------------------------------------
# Graph store (Neo4j)
#
# LOCAL (default) - `docker compose up -d` starts a Neo4j matching these values.
# Leave as-is to use it.
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=docrotlocal
NEO4J_DATABASE=neo4j

# CLOUD (Neo4j Aura) - to use Aura instead of the local container, comment out
# the three lines above and uncomment these, pasting the values from the
# credentials file Aura gives you at instance creation.
#   - the scheme MUST be neo4j+s:// (TLS) for Aura, not bolt://
#   - NEO4J_DATABASE is always `neo4j` on Aura free tier
#
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-aura-generated-password
# NEO4J_DATABASE=neo4j
# NEO4J_AURA_INSTANCEID=xxxxxxxx
# NEO4J_AURA_INSTANCENAME=docrot

# -----------------------------------------------------------------------------
# Extraction LLM - OPTIONAL.
#
# Used only for judgement calls: which tier a snippet belongs to, which
# snippets must run before which, and which symbols a prose claim is about.
# Code fences come from a markdown parser and code symbols from Python's `ast`,
# never from the model.
#
# With no key set, docrot falls back to deterministic rule-based tiering and
# skips prose-claim extraction. The scan still runs end to end.
#
# Routed through OpenRouter, so one key reaches every vendor and the model is
# a config value rather than a provider commitment.
#
# EXTRACTION_MODELS is a comma-separated preference list of `vendor/model` ids.
# The first is the primary; the rest are fallbacks OpenRouter tries in order on
# context-length errors, moderation flags, rate limits, or provider downtime.
# Cost is a rounding error either way - the corpus measures ~30K tokens in and
# ~8K out, so a run is well under a dollar on any of these.
#
#   anthropic/claude-opus-5     strongest judgement
#   anthropic/claude-sonnet-5   cheaper, ample for tier classification
#   openai/gpt-sol-latest       cross-vendor fallback
#   moonshotai/kimi-k2          what the v1 spec originally assumed
#
# Requests pin provider routing to endpoints that actually implement
# json_schema structured output, so a provider cannot silently downgrade the
# schema contract to best-effort JSON.
# -----------------------------------------------------------------------------
EXTRACTION_API_KEY=
EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_MODELS=anthropic/claude-opus-5,anthropic/claude-sonnet-5

# -----------------------------------------------------------------------------
# Embeddings - OPTIONAL. Matches prose claims to code symbols.
# Falls back to lexical identifier matching when unset.
# -----------------------------------------------------------------------------
NOSANA_API_KEY=
# EMBEDDING_ENDPOINT=https://<your-nosana-deployment>/v1
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# -----------------------------------------------------------------------------
# Credentials forwarded INTO sandboxes.
#
# Only variables with this exact prefix are passed to sandboxed snippets; the
# prefix is stripped on injection, so SANDBOX_ENV_PERSEUS_API_KEY arrives in
# the sandbox as PERSEUS_API_KEY. Setting one promotes snippets that need it
# from the `structural` tier to `execute`.
#
# Use scoped, revocable keys only. Values are redacted from captured output
# before anything is written to disk or loaded into the graph.
# -----------------------------------------------------------------------------
# SANDBOX_ENV_PERSEUS_API_KEY=
# SANDBOX_ENV_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Run tuning - all optional, these are the defaults.
# -----------------------------------------------------------------------------
# DOCROT_MAX_PAGES=60
# DOCROT_CONCURRENCY=8
# DOCROT_SNIPPET_TIMEOUT=45
# DOCROT_INSTALL_TIMEOUT=180
# DOCROT_USER_AGENT=docrot/0.1 (+https://github.com/your-org/docrot)
